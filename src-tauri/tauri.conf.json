{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rupantar",
  "version": "0.1.0",
  "identifier": "app.rupantar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Rupantar", "width": 480, "height": 480, "resizable": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
